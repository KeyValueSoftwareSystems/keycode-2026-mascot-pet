{
  "name": "keycode-pet-workspace",
  "version": "1.10.0",
  "private": true,
  "description": "Keycode mascot desktop companion \u2014 workspace root",
  "license": "MIT",
  "author": {
    "name": "KeyValue Systems",
    "email": "doyle@keyvalue.systems"
  },
  "type": "module",
  "main": "apps/desktop/dist/main/main.js",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "install-electron",
    "generate": "node scripts/generate-sprite-css.mjs && node scripts/generate-alpha-mask.mjs",
    "generate:check": "node scripts/generate-sprite-css.mjs --check && node scripts/generate-alpha-mask.mjs --check",
    "build": "pnpm generate:check && pnpm -F @keycode/desktop build",
    "dev": "pnpm -F @keycode/desktop dev",
    "typecheck": "pnpm -F @keycode/desktop typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "smoke:states": "pnpm build && node scripts/smoke.mjs --all-states",
    "lab:linux": "bash docker/linux-lab/lab.sh",
    "manifest:serve": "node scripts/dev-manifest-server.mjs",
    "notify": "pnpm build && node scripts/notify.mjs",
    "notify:list": "pnpm build && node scripts/notify.mjs --list",
    "manifest:check": "pnpm build && node scripts/check-manifest.mjs",
    "package": "pnpm build && electron-builder --mac --config electron-builder.config.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "package:linux-ci-only": "pnpm build && electron-builder --linux --config electron-builder.config.cjs",
    "package:win-ci-only": "pnpm build && electron-builder --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.10.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
