{
  "name": "@keycode/desktop",
  "version": "1.14.12",
  "private": true,
  "description": "Argos — Electron desktop companion",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer && node ../../scripts/copy-static.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
